{"nodes": [{"id": "claude_skills_testing_best_practices_rules_test_data", "label": "Factories and Test Data", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating mutable records inside each test keeps setup visible and lets each test select its factory state; setUp() objects remain in memory until the suite ends."}, {"id": "claude_skills_testing_best_practices_rules_test_data_data_provider", "label": "Data Providers", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a data provider when the setup, test body, and assertions remain the same across input values; give each case a key so a failure identifies the case without counting positions."}], "edges": [{"source": "claude_skills_testing_best_practices_rules_test_data", "target": "claude_skills_testing_best_practices_rules_test_data_data_provider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "data_provider_pattern", "label": "Data Provider / Parameterized Test Usage", "nodes": ["claude_skills_testing_best_practices_rules_finding_features", "claude_skills_testing_best_practices_rules_test_data", "claude_skills_testing_best_practices_rules_endpoint_tests", "claude_skills_testing_best_practices_rules_test_data_data_provider"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": ".claude/skills/testing-best-practices/rules/test-data.md"}]}