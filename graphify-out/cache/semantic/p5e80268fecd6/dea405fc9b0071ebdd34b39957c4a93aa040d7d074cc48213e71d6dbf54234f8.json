{"nodes": [{"id": "claude_skills_testing_best_practices_rules_isolation", "label": "Fakes, Mocks, and Determinism", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests that depend on actual time, randomness, sleeping, or network calls can fail for reasons unrelated to the code under test, so all four must be controlled."}, {"id": "claude_skills_testing_best_practices_rules_isolation_framework_fakes", "label": "Framework Fakes", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass class names to fake() unless the test asserts the complete result, because a fake without class names can hide an unexpected dispatch; create fakes in the test method, not setUp(), so the dependency stays scoped to the test."}, {"id": "claude_skills_testing_best_practices_rules_isolation_outbound_http", "label": "Outbound HTTP Testing", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call Http::preventStrayRequests() and fake the exact endpoint, because a bare Http::fake() accepts unexpected requests and can hide defects."}, {"id": "claude_skills_testing_best_practices_rules_isolation_database", "label": "Database Testing", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run real queries against real records; do not mock the query builder, because the test then asserts the mock. Use LazilyRefreshDatabase so a test that does not use the database skips the migrations."}, {"id": "docs_laravel_mocking", "label": "Laravel Mocking Documentation", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": "https://laravel.com/framework/docs/mocking", "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "claude_skills_testing_best_practices_rules_isolation", "target": "claude_skills_testing_best_practices_rules_isolation_framework_fakes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_testing_best_practices_rules_isolation", "target": "claude_skills_testing_best_practices_rules_isolation_outbound_http", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_testing_best_practices_rules_isolation", "target": "claude_skills_testing_best_practices_rules_isolation_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_testing_best_practices_rules_isolation", "target": "docs_laravel_mocking", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}