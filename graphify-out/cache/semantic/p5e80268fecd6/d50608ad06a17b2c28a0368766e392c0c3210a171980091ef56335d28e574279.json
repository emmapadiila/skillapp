{"nodes": [{"id": "claude_skills_testing_best_practices_rules_endpoint_tests", "label": "Endpoint Tests", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "claude_skills_testing_best_practices_rules_endpoint_tests_tenant_isolation", "label": "Tenant Isolation", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use 404 rather than 403 for a cross-tenant request because 403 confirms that the other tenant's record exists."}, {"id": "claude_skills_testing_best_practices_rules_endpoint_tests_policy_authorization", "label": "Policy-Level Authorization", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An HTTP test cannot identify which mechanism refused the request because middleware, a policy, and abort() can all return 403, so the full permission matrix belongs in a policy or gate test."}, {"id": "claude_skills_testing_best_practices_rules_endpoint_tests_validation_testing", "label": "Testing Validation", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assert the user-visible message, because a message that is present but wrong is a defect; do not assert that a rules array contains a string, because that tests the declaration and not the behavior."}, {"id": "docs_laravel_http_tests", "label": "Laravel HTTP Tests Documentation", "file_type": "document", "source_file": ".claude/skill